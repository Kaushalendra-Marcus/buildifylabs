{
  "mcp": {
    "servers": {
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@latest",
          "mcp"
        ]
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
        }
      }
    }
  }
}
