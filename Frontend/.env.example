# Base URL of the FastAPI backend (no trailing slash).
# REQUIRED in production — the code falls back to http://localhost:8000,
# which is unreachable from a deployed browser.
VITE_API_BASE_URL=http://localhost:8000

# Google Identity Services client id (optional; Google sign-in is hidden when unset).
VITE_GOOGLE_CLIENT_ID=

# GA4 measurement id (optional; analytics is a no-op when unset).
VITE_GA_MEASUREMENT_ID=

# Razorpay publishable key (optional; payments are currently mocked).
VITE_RAZORPAY_KEY_ID=
