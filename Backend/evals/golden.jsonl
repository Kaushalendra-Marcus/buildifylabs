end": "2024-06-30", "metric": "annualTotalRevenue"}, "net_income": {"labels": ["2022-06-30", "2023-06-30", "2024-06-30"], "values": [20.0, 21.0, 23.0], "period_start": "2022-06-30", "period_end": "2024-06-30", "metric": "annualNetIncome"}}]}, "expect": {"clarify": false, "blocked_expected": false, "min_visuals": 1, "no_invented_numbers": true, "answer_nonempty": true}, "notes": "Fully validated 3Y comparison: gate must pass and at least one chart must ship."}
