#     citations_resolve,no_invented_numbers,excluded_entities,no_forecast,no_scenario,
#     forecast_computable,answer_nonempty}, notes
# Runner: Backend/scripts/eval_pipeline.py (deterministic property checks only, no LLM judge).
{"id": "own-01-trend", "query": "how is revenue trending?", "source_scope": "own_data", "seed": {"rows": [{"created_at": "2024-01-01", "revenue": 100, "region": "east"}, {"created_at": "2024-01-02", "revenue": 250, "region": "west"}, {"created_at": "2024-01-03", "revenue": 175, "region": "east"}, {"created_at": "2024-01-04", "revenue": 300, "region": "west"}]}, "expect": {"clarify": false, "min_visuals": 1, "no_invented_numbers": true, "answer_nonempty": true}, "notes": "Basic own-data answer must carry visuals and invent no numbers."}
