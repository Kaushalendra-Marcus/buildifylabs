# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
APP_NAME=BuildifyLabs
VERSION=1.2.0
ENVIRONMENT=development          # set to "production" to enable HSTS
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
DATABASE_SSL=true                # false for a local Postgres without TLS
JWT_SECRET=replace-with-64-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
TRUST_PROXY_HEADERS=false        # true behind App Runner/Vercel/nginx

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CONTACT_FORM_RECIPIENT_EMAIL=

# --- Google auth ---
GOOGLE_CLIENT_ID=

# --- LLM / research ---
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
GROQ_MODEL=
GROQ_FAST_MODEL=
GROQ_STRONG_MODEL=
HF_API_KEY=
HF_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
WEB_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_RESULTS=3
FRED_API_KEY=
REDIS_URL=
ENABLE_LIVE_WEB_SCOPE=true
ENABLE_DOCUMENT_QA=true

# --- Storage ---
UPLOAD_DIR=data/uploads

# --- Abuse limits (per process; use Redis for multi-worker) ---
LOGIN_RATE_LIMIT=5
VERIFY_EMAIL_RATE_LIMIT=3
GUEST_RATE_LIMIT=10
CONTACT_RATE_LIMIT=5
